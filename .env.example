# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for production.

# MongoDB connection string.
#   Local:      mongodb://127.0.0.1:27017   (run `npm run db` first)
#   Production: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net  (MongoDB Atlas, free M0 cluster)
MONGODB_URI=
MONGODB_DB=portfolio

# Password for the /admin dashboard. Use a long random one in production.
ADMIN_PASSWORD=

# Random string, at least 32 characters. Signs the admin login cookie and the daily visitor hash.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: the site's public URL once there is a custom domain (used for social preview images).
# NEXT_PUBLIC_SITE_URL=https://example.com
